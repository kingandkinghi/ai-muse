# machine.env — per-machine settings for the machine-state scripts.
# Copy to "machine.env" beside the scripts and edit for your machine.
# Never commit machine.env. Every value is optional; defaults are neutral.
# The file is a shell fragment: the scripts source it (and export the
# values, so verify.d/ checks can read them).

# Timezone for log timestamps (IANA name). Default: UTC.
MS_TZ=UTC

# Where this machine's manifest lives. Default: manifest.tsv beside ensure.sh.
# MS_MANIFEST=/path/to/manifest.tsv

# Where the masters live. Default: files/ beside ensure.sh.
# MS_FILES_DIR=/path/to/files

# Owner and group used when installing files and directories.
# Defaults: root / root.
# MS_OWNER=root
# MS_GROUP=root

# Extra flags passed to pip installs. Default: --break-system-packages
# (Debian/Ubuntu PEP 668 systems need it; harmless elsewhere is not
# guaranteed — set it to empty if your pip rejects the flag).
# MS_PIP_FLAGS=--break-system-packages
